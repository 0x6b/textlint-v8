{
  "rules": {
    "@0x6b/no-emoji": true,
    "@0x6b/no-emphasis": true,
    "@0x6b/no-hr-before-heading": true,
    "@0x6b/no-numbered-headings-and-bullets": {
      "header": false
    },
    "@0x6b/no-smart-quotes": true,
    "@0x6b/normalize-whitespaces": true,
    "@textlint-ja/preset-ai-writing": true,
    "@textlint-rule/no-invalid-control-character": true,
    "preset-ja-technical-writing": {
      "no-invalid-control-character": false
    }
  }
}
